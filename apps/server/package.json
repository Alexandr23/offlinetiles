{
  "name": "@map-exporter/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts all",
    "dev:api": "tsx watch --clear-screen=false src/main.ts api",
    "dev:worker": "tsx watch --clear-screen=false src/main.ts worker",
    "start": "tsx src/main.ts",
    "api": "tsx src/main.ts api",
    "worker": "tsx src/main.ts worker",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/main.ts migrate"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@map-exporter/contracts": "workspace:*",
    "@maplibre/maplibre-gl-style-spec": "^23.0.0",
    "fastify": "^5.3.0",
    "pmtiles": "^4.3.0",
    "postgres": "^3.4.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
