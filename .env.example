NODE_ENV=development

# HTTP API bind address
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Absolute URL written into exported style.json source/glyphs references.
# Defaults to http://localhost:$PORT. Set this when the API is reached through
# a reverse proxy (Docker Compose full profile uses http://localhost).
PUBLIC_API_URL=http://localhost:3000

# PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL=postgres://mapexporter:mapexporter@localhost:5432/mapexporter

# Root data directory. Relative paths are resolved from the repository root.
DATA_DIR=./data

# Master dataset produced by `pnpm init-map`
MASTER_PMTILES=./data/master/master.pmtiles

# Generated artifacts (one directory per job)
EXPORTS_DIR=./data/exports

# Local fonts / sprites used by styles and the raster renderer
ASSETS_DIR=./data/assets

# Rust generator binary (built by `pnpm build:rust`)
GENERATOR_BINARY=./rust/target/release/tile-generator

# 0 = automatic (available_parallelism - 1, minimum 1)
GENERATOR_THREADS=0

# Queue worker poll interval when idle, and SSE/DB progress throttle (500–1000 ms)
WORKER_POLL_INTERVAL_MS=1000
PROGRESS_THROTTLE_MS=750

# Raster renderer sidecar (Node + MapLibre Native). Space-separated command.
RASTER_RENDERER_COMMAND=node ./apps/renderer/src/index.js

# Safety limits for export requests
MAX_EXPORT_TILES=5000000
# Empty = use master dataset max zoom
MAX_ZOOM=

# Fallback estimate parameters used before enough history exists
ESTIMATE_VECTOR_BYTES_PER_TILE=12000
ESTIMATE_VECTOR_MS_PER_TILE=0.5
ESTIMATE_RASTER_BYTES_PER_TILE=18000
ESTIMATE_RASTER_MS_PER_TILE=25

# Vite dev-server proxy target (apps/web). Defaults to http://localhost:3000.
# VITE_API_PROXY=http://localhost:3000

# Hardcoded admin credentials (ensured on API startup)
ADMIN_LOGIN=admin
ADMIN_PASSWORD="change-me-to-a-strong-password"
# Session lifetime for guest / user / admin tokens
SESSION_TTL_DAYS=30

# Docker Compose (`--profile full`, production). Read by docker-compose.yml only.
# Public origin used in exported style.json files.
PUBLIC_URL=http://localhost
# Set before the first `docker compose up`: Postgres keeps the password it was initialized with.
# Use letters/digits only (it is embedded in DATABASE_URL).
POSTGRES_PASSWORD=mapexporter
# Uncomment on the server so plain `docker compose ...` includes server/worker/web/certbot.
# COMPOSE_PROFILES=full
# Host ports for the nginx container (80/443 on the server; change locally if they are taken).
# WEB_HTTP_PORT=80
# WEB_HTTPS_PORT=443

# Initialization (pnpm init-map). Planetiler runs through Docker by default.
PLANETILER_IMAGE=ghcr.io/onthegomap/planetiler:latest
# Set to a local planetiler.jar to run with a local Java 21+ instead of Docker
PLANETILER_JAR=
# Optional: Java 21+ home for PLANETILER_JAR (wins over shell JAVA_HOME)
# PLANETILER_JAVA_HOME=
# JAVA_HOME=
# Planetiler JVM memory, e.g. 2g for small regions; 8g is typical with mmap planet mode
# Jar/docker runs also pass -XX:+UseParallelGC (more stable than G1 on long planet builds)
PLANETILER_MEMORY=2g
